{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=stacktrigger-db;Port=5432;Database=stacktrigger;Username=postgres;Password=postgres"
  },
  "AtsScraper": {
    "TargetUrls": [
      "https://remoteok.com/remote-engineer-jobs"
    ],
    "MonitoredKeywords": [
      "Azure",
      "AWS",
      "Cloud Migration",
      ".NET",
      ".NET 9",
      "Clean Architecture",
      "SOC2",
      "Cybersecurity",
      "Kubernetes",
      "Terraform",
      "CrowdStrike"
    ],
    "UserAgent": "StackTriggerScout/1.0 (+https://stacktrigger.com/bot)"
  },
  "WebhookDispatcher": {
    "BatchSize": 50
  }
}
